//Configs: {
RijamsModConfigClient: {
	DisplayName: Client Options
	Headers.ClientOption: "[c/00FF00:Client Option]"

	Ornithophobia: {
		Label: "[i:RijamsMod/IntTrav_Helmet]   Ornithophobia"
		Tooltip:
			'''
			This option toggles if the Interstellar Traveler will wear a helmet or not
			  When On: the Interstellar Traveler will wear a helmet.
			  When Off: the Interstellar Traveler will not wear a helmet.
			    Turn On if you don't want to see her head
			Default value: Off
			Requires Reload.
			'''
	}

	BurglarsRingSound: {
		Label: "[i:RijamsMod/BurglarsRing]   Burglar's Ring Notification Sound"
		Tooltip:
			'''
			This option controls the volume of the sound the Burglar's Ring will make upon successfully working
			    Set to 0 if you don't want to hear the sound
			Default value: 100
			Reload not required.
			'''
	}

	DisplayWhipMultihitPenalty: {
		Label: "[i:4672]   Display Whip Multihit Penalty"
		Tooltip:
			'''
			This option toggles if whips will display the mutlihit penalty in the tooltip.
			  When On: Multihit Penalty will always be displayed.
			  When Hold Shift: Multihit Penalty will only be displayed when holding left shift.
			  When Off: Multihit Penalty will not be shown.
			    Turn Off if you don't want to see the tooltip.
			Default value: On
			'''
	}

	DisplayDefenseSupportSummonsAura: {
		Label: "[i:RijamsMod/CobaltProtectorCudgel]   Display Defense Support Summons Auras"
		Tooltip:
			'''
			This option toggles if defense support summons will show their aura.
			  When Opaque: The dust indicator will be shown as completely opaque.
			  When Normal: The dust indicator will be shown as semi-transparent.
			  When Faded: The dust indicator will be shown as almost completely transparent.
			  When Off: The dust indicator will be hidden.
			    Turn Off if you don't want to see the auras.
			Default value: Normal
			'''
	}

	DisplayHealingSupportSummonsAura: {
		Label: "[i:RijamsMod/RadiantLanternCudgel]   Display Healing Support Summons Auras"
		Tooltip:
			'''
			This option toggles if healing support summons will show their aura.
			  When Opaque: The dust indicator will be shown as completely opaque.
			  When Normal: The dust indicator will be shown as semi-transparent.
			  When Faded: The dust indicator will be shown as almost completely transparent.
			  When Off: The dust indicator will be hidden.
			    Turn Off if you don't want to see the auras.
			Default value: Normal
			'''
	}

	SnowDuringFrostLegion: {
		Label: "[i:SnowGlobe]   Snow During the Frost Legion"
		Tooltip:
			'''
			This option toggles if it will snow during the Frost Legion.
			This is completely visual and has no extra impact on gameplay.
			  When On: It will snow while fighting the Frost Legion.
			  When Off: It will not snow while fighting the Frost Legion.
			    Turn Off if you don't want to see the snow.
			Default value: On
			'''
	}
}

WhipMultihitPenalty: {
	Tooltip: ""

	On: {
		Label: On
		Tooltip:
			'''
			{$Label}

			When On: Multihit Penalty will always be displayed.
			'''
	}

	HoldShift: {
		Label: Hold Shift
		Tooltip:
			'''
			{$Label}

			When Hold Shift: Multihit Penalty will only be displayed when holding left shift.
			'''
	}

	Off: {
		Label: Off
		Tooltip:
			'''
			{$Label}

			When Off: Multihit Penalty will not be shown.
			Set to this for vanilla behavior or to turn this feature off.
			'''
	}
}

SupportSummonsAura: {
	Tooltip: ""

	Opaque: {
		Label: Opaque
		Tooltip:
			'''
			{$Label}

			When Opaque: The dust indicator will be shown as completely opaque.
			'''
	}

	Normal: {
		Label: Normal
		Tooltip:
			'''
			{$Label}

			When Normal: The dust indicator will be shown as semi-transparent.
			'''
	}

	Faded: {
		Label: Faded
		Tooltip:
			'''
			{$Label}

			When Faded: The dust indicator will be shown as almost completely transparent.
			'''
	}

	Off: {
		Label: Off
		Tooltip:
			'''
			{$Label}

			When Off: The dust indicator will be hidden.
			Turn Off if you don't want to see the auras.
			'''
	}
}

RijamsModConfigServer: {
	DisplayName: Server Options
	Headers.ServerOptions: "[c/00FF00:Server Options]"

	VanillaArmorChanges: {
		Label: "[i:848]   Vanilla Vanity and Armor Changes"
		Tooltip:
			'''
			This option toggles if certain vanilla vanity sets are changed into armor sets
			and if certain vanilla armor sets are changed.

			Turn Off to keep them the same as vanilla or for cross mod compatibility.

			Default value: On
			Requires a Reload.
			'''
	}

	JoustingLanceStaticInvincibility: {
		Label: "[i:4788]   Jousting Lances use Static Invincibility"
		Tooltip:
			'''
			This option toggles if Jousting Lances use 
			static invincibility or global invincibility.
			  When On: Jousting Lances use static invincibility.
			  When Off: Jousting Lances use global invincibility.
			    Turn Off for vanilla behavior.
			Default value: On

			Global Invincibility means damaged entities will be temporarily
			  invulnerable to all sources of piercing damage from the same player.
			  This type of invincibility will block other types of attacks from the player.
			Static Invincibility means damaged entities will only be
			  invulnerable to damage from that specific projectile type.
			  This type of invincibility allows other attacks to still deal damage.
			'''
	}

	YoyoStaticInvincibility: {
		Label: "[i:3278]   Yoyos use Static Invincibility"
		Tooltip:
			'''
			This option toggles if Yoyos use 
			static invincibility or global invincibility.
			  When On: Yoyos use static invincibility.
			  When Off: Yoyos use global invincibility.
			    Turn Off for vanilla behavior.
			Default value: On

			Global Invincibility means damaged entities will be temporarily
			  invulnerable to all sources of piercing damage from the same player.
			  This type of invincibility will block other types of attacks from the player.
			Static Invincibility means damaged entities will only be
			  invulnerable to damage from that specific projectile type.
			  This type of invincibility allows other attacks to still deal damage.
			'''
	}

	TownNPCsCrossModSupport: {
		Label: "[i:3121]   Town NPCs Cross Mod Support"
		Tooltip:
			'''
			This option toggles if the Town NPCs will sell items from other mods,
			if they will have cross mod dialog, and cross mod happiness.
			  When On: The Town NPCs will sell cross mod items.
			  When Off: The Town NPCs WILL NOT sell cross mod items.
			    Turn Off to remove cross mod items from the shops and dialog.
			Default value: On
			Reload not required for dialog and shop items.
			Reload required for happiness.
			'''
	}

	LoadDebugItems: {
		Label: "[i:784]   Load Debug Items"
		Tooltip:
			'''
			This option toggles if the debug items will be loaded.
			  When On: The debug items WILL be loaded.
			  When Off: The debug items WILL NOT be loaded.
			    Turn On to load the debug items.
			Default value: Off
			Requires a Reload.
			'''
	}

	CatchNPCs: {
		Label: "[i:1991]   Catch Town NPCs"
		Tooltip:
			'''
			This option toggles if the Town NPCs added by this mod can be
			caught with a Bug Net (Fargo's Mutant Mod style)
			  When On: The Town NPCs CAN be caught.
			  When Off: The Town NPCs CAN NOT be caught.
			    Turn On to catch the Town NPCs.
			Default value: Off
			Requires a Reload.
			'''
	}

	SnowBallaGriefing: {
		Label: "[i:SnowBlock]   Snow Balla Griefing"
		Tooltip:
			'''
			This option toggles if the snowballs thrown by the Snow Balla will place snow blocks.
			  When On: Same as vanilla. The snowballs will place snow block tiles.
			  When Drop as Item: The snowballs will drop snow block items instead.
			  When Off: The snowballs will not place nor drop anything.
			    Turn Off if you don't want your world filled with snow blocks.
			Default value: Drop as Item
			'''
	}
}

SnowBallaGriefingOptions: {
	Tooltip: ""

	On: {
		Label: On
		Tooltip:
			'''
			{$Label}

			When On: Same as vanilla. The snowballs will place snow block tiles.
			Set to this for vanilla behavior.
			'''
	}

	DropAsItem: {
		Label: Drop as Item
		Tooltip:
			'''
			{$Label}

			When Drop as Item: The snowballs will drop snow block items instead.
			'''
	}

	Off: {
		Label: Off
		Tooltip:
			'''
			{$Label}

			When Off: The snowballs will not place nor drop anything.
			'''
	}
}

VanillaArmorList: {
	Tooltip: ""

	PharaohsSet: {
		Label: Pharaoh's Set [i:PharaohsMask] [i:PharaohsRobe]
		Tooltip:
			'''
			The Pharaoh's vanity set will be turned into armor.

			Pharaoh's Mask:
			  2 Defense

			Pharaoh's Robe:
			  3 Defense

			Set Bonus:
			  10% reduced mana usage
			  +1 Minion capacity
			  +10% Whip range
			  5% increased movement speed
			  Grants Immunity to Mighty Wind
			'''
	}

	AncientSet: {
		Label: Ancient Set [i:AncientArmorHat] [i:AncientArmorShirt] [i:AncientArmorPants]
		Tooltip:
			'''
			The Ancient vanity set will be turned into armor.

			Ancient Headdress:
			  10 Defense
			  +5 critical strike chance
			  20% chance to not consume ammo

			Ancient Garments:
			  14 Defense
			  20% increased damage
			  +1 Minion capacity
			  +5 Support minion radius

			Ancient Slacks:
			  9 Defense
			  10% increased melee speed
			  10% reduced mana usage
			  +2 life regeneration

			Set Bonus:
			  Increased maximum running speed
			  Increased running acceleration
			  +0.5 seconds flight time
			  +15% Whip speed
			  +20% Whip range
			  Allows Shield of Cthulhu style dashing
			'''
	}

	BuffStardustSetBonus: {
		Label: Buff Stardust Set Bonus [i:StardustHelmet] [i:StardustBreastplate] [i:StardustLeggings]
		Tooltip:
			'''
			The Stardust armor's set bonus will be buffed.

			+15% Whip speed
			'''
	}

	BuffBeeGreaves: {
		Label: Buff Bee Greaves [i:BeeGreaves]
		Tooltip:
			'''
			The Bee Greaves will be buffed.

			+1 Sentry capacity
			'''
	}

	BuffFlinxFurCoat: {
		Label: Buff Flinx Fur Coat [i:FlinxFurCoat]
		Tooltip:
			'''
			The Flinx Fur Coat will be buffed.

			3 Defense (from 1)
			'''
	}
}
